# Add your Groq API key from https://console.groq.com/keys.
# Never commit .env or paste the key into a browser/frontend file.
GROQ_API_KEY=

# Default is an active model shown in Groq's published model list at the time this project was updated.
# Check https://console.groq.com/docs/models if Groq changes the available models.
GROQ_MODEL=openai/gpt-oss-20b

# Shared-password protection. Set a long, unique password before hosting this app publicly.
APP_ACCESS_USERNAME=analyst
APP_ACCESS_PASSWORD=
# Local development only (run-windows.bat binds to localhost).
# Hosted deployments should set REQUIRE_AUTH=true; the app also defaults to locked if unset.
REQUIRE_AUTH=false

# These are conservative review routing thresholds. Groq confidence is not calibrated by this project.
REVIEW_CONFIDENCE_THRESHOLD=0.72
EVIDENCE_CONFIDENCE_THRESHOLD=0.65
